{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "exercisebook-app",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-07-14",
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "ratelimits": [
    {
      "name": "PREVIEW_RATE_LIMITER",
      "namespace_id": "321001",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
}
