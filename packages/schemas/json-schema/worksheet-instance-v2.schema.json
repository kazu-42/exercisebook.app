{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "$ref": "#/$defs/__schema0" },
    "assignmentId": { "$ref": "#/$defs/__schema1" },
    "title": { "$ref": "#/$defs/__schema2" },
    "localStudyDate": { "$ref": "#/$defs/__schema3" },
    "timeZone": { "$ref": "#/$defs/__schema4" },
    "locale": { "$ref": "#/$defs/__schema5" },
    "expectedMinutes": { "$ref": "#/$defs/__schema6" },
    "plan": { "$ref": "#/$defs/__schema7" },
    "policy": { "$ref": "#/$defs/__schema9" },
    "skillGraph": { "$ref": "#/$defs/__schema10" },
    "rng": { "$ref": "#/$defs/__schema11" },
    "content": { "$ref": "#/$defs/__schema13" },
    "presentation": { "$ref": "#/$defs/__schema15" },
    "slots": { "$ref": "#/$defs/__schema22" },
    "attributions": { "$ref": "#/$defs/__schema29" }
  },
  "required": [
    "schema",
    "assignmentId",
    "title",
    "localStudyDate",
    "timeZone",
    "locale",
    "expectedMinutes",
    "plan",
    "policy",
    "skillGraph",
    "rng",
    "content",
    "presentation",
    "slots",
    "attributions"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "string", "const": "exercisebook.worksheet-instance/v2" },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9](?:[a-z0-9._:-]*[a-z0-9])?$"
    },
    "__schema2": { "type": "string", "minLength": 1, "maxLength": 240 },
    "__schema3": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "__schema4": { "type": "string", "minLength": 1, "maxLength": 80 },
    "__schema5": { "type": "string", "minLength": 2, "maxLength": 255 },
    "__schema6": { "type": "integer", "exclusiveMinimum": 0, "maximum": 480 },
    "__schema7": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/__schema1" },
        "version": { "$ref": "#/$defs/__schema8" }
      },
      "required": ["id", "version"],
      "additionalProperties": false
    },
    "__schema8": { "type": "integer", "exclusiveMinimum": 0, "maximum": 2147483647 },
    "__schema9": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/__schema1" },
        "version": { "$ref": "#/$defs/__schema8" }
      },
      "required": ["id", "version"],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/__schema1" },
        "revision": { "$ref": "#/$defs/__schema8" }
      },
      "required": ["id", "revision"],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "algorithm": { "type": "string", "const": "xoshiro128ss-v1" },
        "baseSeed": { "$ref": "#/$defs/__schema12" },
        "seedSecretVersion": { "$ref": "#/$defs/__schema1" }
      },
      "required": ["algorithm", "baseSeed", "seedSecretVersion"],
      "additionalProperties": false
    },
    "__schema12": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "__schema13": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema14" }
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/__schema1" },
        "revision": { "$ref": "#/$defs/__schema8" },
        "sourceHash": { "$ref": "#/$defs/__schema12" },
        "contentHash": { "$ref": "#/$defs/__schema12" },
        "compilerVersion": {
          "type": "string",
          "const": "exercisebook-content-compiler/2"
        }
      },
      "required": ["id", "revision", "sourceHash", "contentHash", "compilerVersion"],
      "additionalProperties": false
    },
    "__schema15": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "exercisebook.worksheet-presentation/v1"
        },
        "content": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "const": "math.fractions.add-unlike-denominators"
            },
            "revision": { "type": "number", "const": 2 },
            "sourceHash": { "$ref": "#/$defs/__schema12" },
            "contentHash": { "$ref": "#/$defs/__schema12" },
            "compilerVersion": {
              "type": "string",
              "const": "exercisebook-content-compiler/2"
            }
          },
          "required": [
            "id",
            "revision",
            "sourceHash",
            "contentHash",
            "compilerVersion"
          ],
          "additionalProperties": false
        },
        "lesson": {
          "type": "object",
          "properties": {
            "nodeId": { "type": "string", "const": "lesson-explanation-01" },
            "title": { "type": "string", "minLength": 1, "maxLength": 240 },
            "paragraphs": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": { "$ref": "#/$defs/__schema16" }
            }
          },
          "required": ["nodeId", "title", "paragraphs"],
          "additionalProperties": false
        },
        "workedExample": {
          "type": "object",
          "properties": {
            "nodeId": { "type": "string", "const": "worked-example-01" },
            "title": { "type": "string", "minLength": 1, "maxLength": 240 },
            "model": {
              "type": "object",
              "properties": {
                "type": { "$ref": "#/$defs/__schema17" },
                "left": { "$ref": "#/$defs/__schema18" },
                "right": { "$ref": "#/$defs/__schema18" },
                "result": { "$ref": "#/$defs/__schema18" },
                "commonDenominator": { "$ref": "#/$defs/__schema21" },
                "leftScaledNumerator": { "$ref": "#/$defs/__schema20" },
                "rightScaledNumerator": { "$ref": "#/$defs/__schema20" },
                "unreducedSumNumerator": { "$ref": "#/$defs/__schema20" }
              },
              "required": [
                "type",
                "left",
                "right",
                "result",
                "commonDenominator",
                "leftScaledNumerator",
                "rightScaledNumerator",
                "unreducedSumNumerator"
              ],
              "additionalProperties": false
            },
            "steps": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": { "$ref": "#/$defs/__schema16" }
            }
          },
          "required": ["nodeId", "title", "model", "steps"],
          "additionalProperties": false
        },
        "exercise": {
          "type": "object",
          "properties": {
            "nodeId": { "type": "string", "const": "practice-01" },
            "instruction": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "required": ["nodeId", "instruction"],
          "additionalProperties": false
        }
      },
      "required": ["schema", "content", "lesson", "workedExample", "exercise"],
      "additionalProperties": false
    },
    "__schema16": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "__schema17": { "type": "string", "const": "fraction-addition" },
    "__schema18": { "$ref": "#/$defs/__schema19" },
    "__schema19": {
      "type": "object",
      "properties": {
        "numerator": { "$ref": "#/$defs/__schema20" },
        "denominator": { "$ref": "#/$defs/__schema20" }
      },
      "required": ["numerator", "denominator"],
      "additionalProperties": false
    },
    "__schema20": {
      "type": "string",
      "maxLength": 129,
      "pattern": "^(?:0|-?[1-9][0-9]{0,127})$"
    },
    "__schema21": {
      "allOf": [
        { "pattern": "^(?:0|-?[1-9][0-9]{0,127})$" },
        { "pattern": "^[1-9][0-9]*$" }
      ],
      "$ref": "#/$defs/__schema20"
    },
    "__schema22": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema23" }
    },
    "__schema23": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/__schema1" },
        "skillIds": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": { "$ref": "#/$defs/__schema1" }
        },
        "slotSeed": { "$ref": "#/$defs/__schema12" },
        "selectionReasons": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": { "$ref": "#/$defs/__schema24" }
        },
        "expectedMinutes": { "type": "integer", "exclusiveMinimum": 0, "maximum": 120 },
        "prompt": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "fraction-addition" },
            "instruction": { "type": "string", "minLength": 1, "maxLength": 500 },
            "left": { "$ref": "#/$defs/__schema25" },
            "right": { "$ref": "#/$defs/__schema25" },
            "accessibleText": { "type": "string", "minLength": 1, "maxLength": 1000 }
          },
          "required": ["type", "instruction", "left", "right", "accessibleText"],
          "additionalProperties": false
        },
        "canonicalAnswer": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "rational" },
            "value": { "$ref": "#/$defs/__schema25" }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        "scoringRule": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "rational-equals" },
            "accepted": { "$ref": "#/$defs/__schema25" },
            "requireReduced": { "type": "boolean" }
          },
          "required": ["type", "accepted", "requireReduced"],
          "additionalProperties": false
        },
        "hints": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": { "$ref": "#/$defs/__schema26" }
        },
        "solutionTrace": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": { "$ref": "#/$defs/__schema27" }
        },
        "misconceptions": {
          "maxItems": 20,
          "type": "array",
          "items": { "$ref": "#/$defs/__schema28" }
        },
        "accessibility": {
          "type": "object",
          "properties": {
            "summary": { "type": "string", "minLength": 1, "maxLength": 2000 }
          },
          "required": ["summary"],
          "additionalProperties": false
        },
        "printFallback": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "text" },
            "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
          },
          "required": ["type", "text"],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "contentId": { "$ref": "#/$defs/__schema1" },
            "contentRevision": { "$ref": "#/$defs/__schema8" },
            "sourceHash": { "$ref": "#/$defs/__schema12" },
            "contentHash": { "$ref": "#/$defs/__schema12" },
            "compilerVersion": {
              "type": "string",
              "const": "exercisebook-content-compiler/2"
            },
            "generatorId": { "type": "string", "const": "fractions.add" },
            "generatorVersion": { "type": "string", "const": "1" },
            "generationAttempt": { "type": "integer", "minimum": 0, "maximum": 127 }
          },
          "required": [
            "contentId",
            "contentRevision",
            "sourceHash",
            "contentHash",
            "compilerVersion",
            "generatorId",
            "generatorVersion",
            "generationAttempt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "skillIds",
        "slotSeed",
        "selectionReasons",
        "expectedMinutes",
        "prompt",
        "canonicalAnswer",
        "scoringRule",
        "hints",
        "solutionTrace",
        "misconceptions",
        "accessibility",
        "printFallback",
        "provenance"
      ],
      "additionalProperties": false
    },
    "__schema24": {
      "type": "string",
      "enum": ["due-review", "prerequisite-repair", "current-frontier", "transfer"]
    },
    "__schema25": { "$ref": "#/$defs/__schema19" },
    "__schema26": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/__schema1" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "required": ["id", "text"],
      "additionalProperties": false
    },
    "__schema27": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/__schema1" },
        "kind": {
          "type": "string",
          "enum": [
            "common-denominator",
            "rewrite-left",
            "rewrite-right",
            "add-numerators",
            "reduce"
          ]
        },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "expression": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "accessibleText": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "result": { "$ref": "#/$defs/__schema25" }
      },
      "required": ["id", "kind", "explanation", "expression", "accessibleText"],
      "additionalProperties": false
    },
    "__schema28": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/__schema1" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "incorrectAnswer": { "$ref": "#/$defs/__schema25" }
      },
      "required": ["id", "description", "incorrectAnswer"],
      "additionalProperties": false
    },
    "__schema29": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema30" }
    },
    "__schema30": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "author": { "type": "string", "minLength": 1, "maxLength": 240 },
        "sourceUrl": { "type": "string", "maxLength": 2048, "format": "uri" },
        "licenseId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "attributionText": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "publicationStatus": { "type": "string", "enum": ["draft", "published"] },
        "modifications": {
          "maxItems": 50,
          "type": "array",
          "items": { "$ref": "#/$defs/__schema31" }
        }
      },
      "required": [
        "title",
        "author",
        "sourceUrl",
        "licenseId",
        "attributionText",
        "publicationStatus",
        "modifications"
      ],
      "additionalProperties": false
    },
    "__schema31": { "type": "string", "minLength": 1, "maxLength": 500 }
  },
  "$id": "https://exercisebook.app/schemas/worksheet-instance-v2.schema.json",
  "x-exercisebook-runtime-invariants": [
    "Original input is a plain data-object graph limited to 50,000 graph nodes, depth 128, and 1,000,000 aggregate property-name and string-value code units, with valid Unicode and without prototype-sensitive own keys, accessors, symbols, or cycles.",
    "The selected presentation uses the fixed revision-2 content ID, compiler, and lesson, worked-example, and exercise node IDs for presentation v1; its bounded source and compiled content hashes are authorized against policy by the resolver.",
    "The worked-example common denominator, scaled numerators, unreduced sum numerator, and reduced result equal independent exact-integer derivations from its operands.",
    "Top-level content references are unique by content ID and revision and use compiler v2.",
    "The selected presentation content matches exactly one top-level content reference.",
    "Slot IDs are unique.",
    "Each slot has unique skill IDs, selection reasons, hint IDs, solution-step IDs, and misconception IDs.",
    "Every slot provenance content ID, revision, source hash, compiled content hash, and compiler version matches both the selected presentation and exactly one top-level content reference.",
    "Every slot uses fractions.add@1 and its prompt instruction equals the selected exercise instruction.",
    "Every slot canonical answer equals the exact rational sum of its prompt operands.",
    "No slot canonical answer is rationally equal to the selected worked-example left operand, right operand, or result.",
    "The scoring rule equals the canonical answer.",
    "The final solution result equals the canonical answer.",
    "Top-level expectedMinutes equals the sum of slot expectedMinutes.",
    "localStudyDate is a real Gregorian calendar date.",
    "timeZone is recognized as an IANA time-zone identifier by the runtime.",
    "locale is a canonical BCP 47 tag accepted by Intl.Locale.",
    "Rational values are reduced, lexically canonical, bounded, and have positive denominators.",
    "Attribution source URLs use HTTP(S) and contain no credentials."
  ]
}
